      <aliases enabled='yes' />
      <column datatype='integer' name='[Amount]' role='measure' type='quantitative' />
      <column datatype='integer' name='[Boxes Shipped]' role='measure' type='quantitative' />
      <column caption='Shipment count' datatype='integer' name='[Calculation_1314769664100392960]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Count([__tableau_internal_object_id__].[data_FC2DA2F396B54582932A34041F67E519])' />
      </column>
      <column caption='Z score' datatype='real' name='[Calculation_1683783359304114177]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Amount]) - WINDOW_AVG(SUM([Amount]))) / WINDOW_STDEV(SUM([Amount]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Anomaly flag' datatype='string' name='[Calculation_1683783359304224770]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ABS([Calculation_1683783359304114177]) &gt; 0.5 THEN &quot;Anomaly&quot; ELSE &quot;Normal&quot; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='data cleanup' datatype='string' name='[Calculation_1683783359313559555]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([Product], &quot;Unknown&quot;)' />
      </column>
      <column caption='Max Sales per date and country' datatype='integer' name='[Calculation_1683783359314857988]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Date], [Country]: MAX({ FIXED [Date], [Country], [Product]: SUM([Amount]) }) }' />
      </column>
      <column caption='Top selling product' datatype='string' name='[Calculation_1683783359316033541]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF { FIXED [Date], [Country], [Product]: SUM([Amount]) } = &#13;&#10;   { FIXED [Date], [Country]: MAX({ FIXED [Date], [Country], [Product]: SUM([Amount]) }) } &#13;&#10;THEN [Product] &#13;&#10;END' />
      </column>
      <column caption='Top 3 products' datatype='string' name='[Calculation_1683783359322427399]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF RANK_UNIQUE(SUM([Amount])) &lt;= 3 THEN &quot;Top 3&quot; ELSE &quot;Others&quot; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
